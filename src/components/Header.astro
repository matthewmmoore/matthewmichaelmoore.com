---
import { brand } from '../config/brand';
const nav = [['Services', '/services/'], ['Work', '/work/'], ['About', '/about/'], ['Contact', '/contact/']];
---
<header class="site-header"><div class="container nav-wrap">
  <a class="brand" href="/" aria-label={`${brand.displayName} home`}><img src="/icon.png" alt="" width="40" height="17" /><span>{brand.displayName}</span></a>
  <nav aria-label="Primary navigation"><ul>{nav.map(([label, href]) => <li><a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a></li>)}</ul></nav>
  <a class="header-cta" href="/contact/">Discuss a Project</a>
</div></header>
