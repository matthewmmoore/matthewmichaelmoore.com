---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { brand } from '../config/brand';
---
<BaseLayout title="Contact | Matthew Moore" description="Contact Matthew Moore to discuss custom software, business workflow, reporting, or systems integration needs."><Breadcrumbs items={[{label:'Contact'}]} /><section class="page-hero container"><p class="eyebrow">Contact</p><h1>Let’s talk about the work in front of you.</h1><p>If you have a software or operational problem to explore, I’d be glad to hear the context.</p></section><section class="section alt"><div class="container prose">{brand.contactFormEndpoint ? <form action={brand.contactFormEndpoint} method="POST"><input type="hidden" name="redirect" value="/thank-you/" /><label>Your name <input required name="name" /></label><label>Email <input required type="email" name="email" /></label><label>How can I help? <textarea required name="message" rows="6"></textarea></label><button class="button" type="submit">Send inquiry</button></form> : <div class="email-card"><div><h2>Send an email</h2><p>You’ll receive a response {brand.responseTime}.</p><a href={`mailto:${brand.email}`}>{brand.email}</a></div><a class="button" href={`mailto:${brand.email}`}>Email Matthew</a></div>}<h2>What to include</h2><p>A short description of the process, system, or question you’re working through is plenty. You may also find it helpful to review my <a href="/services/">services</a> or <a href="/work/">project overview</a> first.</p></div></section></BaseLayout>
